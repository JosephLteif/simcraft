# Copy to .env.docker and set the required values before starting Compose.
#
# JWT_SECRET and SESSION_ENCRYPTION_KEY are optional. If omitted, the server
# generates separate random values and stores them in the persistent /data
# volume. To supply your own values, generate them with `openssl rand -hex 32`
# (run it twice), use the PowerShell example in docs/docker-hosting.md, or use
# the documented online browser-local option. Never commit real values here.
WHYLOWDPS_HOST_IP=192.168.1.20
WHYLOWDPS_PORT=8000
# Optional overrides; leave these commented to use automatic generation.
# JWT_SECRET=64-lowercase-hex-characters
# SESSION_ENCRYPTION_KEY=another-64-lowercase-hex-value
# Use the exact Battle.net BattleTag that will perform the first login.
WHYLOWDPS_BOOTSTRAP_ADMIN_BATTLETAG="YourBattleTag#1234"
WHYLOWDPS_SECURE_COOKIES=false
SIMC_CHANNEL=weekly
# Optional Docker update manager. Enable it with:
# docker compose --env-file .env.docker --profile updates up -d
# Use a long random value and keep it private; the companion needs Docker API access.
# WHYLOWDPS_DOCKER_UPDATE_TOKEN=replace-with-a-long-random-token
# Optional shared Warcraft Logs public API credentials. Personal credentials
# can instead be configured by each user under Settings > Integrations.
# WARCRAFT_LOGS_CLIENT_ID=your-warcraft-logs-client-id
# WARCRAFT_LOGS_CLIENT_SECRET=your-warcraft-logs-client-secret
MAX_CONCURRENT_SIMULATIONS=2
MAX_JOBS_PER_USER=200
